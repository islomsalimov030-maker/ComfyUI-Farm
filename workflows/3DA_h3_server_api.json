   "device": "default"
  },
  "_meta": {
   "title": "Движок · clip"
  }
 },
 "vae": {
  "class_type": "VAELoader",
  "inputs": {
   "vae_name": "minimax_h3_video_vae_fp16.safetensors"
  },
  "_meta": {
   "title": "Движок · vae"
  }
 },
 "avae": {
  "class_type": "VAELoader",
  "inputs": {
   "vae_name": "minimax_h3_audio_vae_fp32.safetensors"
  },
  "_meta": {
   "title": "Движок · avae"
  }
 },
 "ref_room": {
  "class_type": "LoadImage",
  "inputs": {
   "image": "3da_manual/plate.png"
  },

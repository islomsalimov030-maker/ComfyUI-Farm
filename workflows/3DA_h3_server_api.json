   "title": "Карта силы · красный канал"
  }
 },
 "save_raw": {
  "class_type": "SaveImage",
  "inputs": {
   "images": [
    "D1_select",
    0
   ],
   "filename_prefix": "3DA_manual/raw"
  },
  "_meta": {
   "title": "Сохранить · raw H3"
  }
 }
}
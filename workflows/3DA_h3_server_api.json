   "title": "Плита комнаты"
  }
 },
 "ref_char": {
  "class_type": "LoadImage",
  "inputs": {
   "image": "3da_manual/ref_char.png"
  },
  "_meta": {
   "title": "Референс персонажа · SFW"
  }
 },
 "r2v": {
  "class_type": "MiniMaxH3ReferenceToVideo",
  "inputs": {
   "clip": [
    "clip",
    0
   ],
   "vae": [
    "vae",
    0
   ],
   "audio_vae": [
    "avae",
    0
   ],
   "width": 1344,
   "height": 768,
   "length": 5,
   "ref_image_size": "match",
   "prompt": [
    "prompt_text",
    0
   ],
   "ref_images.ref_image_0": [
    "ref_room",
    0
   ],
   "ref_images.ref_image_1": [
    "ref_char",
    0
   ],
   "ref_videos.ref_video_0": [
    "playblast5",
    0
   ]
  },
  "_meta": {
   "title": "Движок · r2v"
  }
 },
 "save": {
  "class_type": "SaveImage",
  "inputs": {
   "images": [
    "final_composite",
    0
   ],
   "filename_prefix": "3DA_manual/result"
  },
  "_meta": {
   "title": "Сохранить · финальная вклейка"
  }
 },
 "plate_scale": {
  "class_type": "ImageScale",
  "inputs": {
   "image": [
    "ref_room",
    0
   ],
   "upscale_method": "lanczos",
   "width": 1344,
   "height": 768,
   "crop": "disabled"
  },
  "_meta": {
   "title": "Движок · plate_scale"
  }
 },
 "regional_model": {
  "class_type": "DifferentialDiffusion",
  "inputs": {
   "model": [
    "shift",
    0
   ],
   "strength": 1.0
  },
  "_meta": {
   "title": "Движок · regional_model"
  }
 },
 "D1_lat": {
  "class_type": "H3LatentFromImage",
  "inputs": {
   "h3_latent": [
    "r2v",
    1
   ],
   "vae": [
    "vae",
    0
   ],
   "image": [
    "init_input",
    0
   ],
   "model": [
    "regional_model",
    0
   ],
   "steps": 25,
   "scheduler": "simple",
   "denoise": 1.0,
   "always_encode": true,
   "mask": [
    "strength_mask",
    0
   ]
  },
  "_meta": {
   "title": "Движок · D1_lat · h3_img2img_latent v0.2.0"
  }
 },
 "D1_noise": {
  "class_type": "RandomNoise",
  "inputs": {
   "noise_seed": 101,
   "control_after_generate": "fixed"
  },
  "_meta": {
   "title": "Движок · D1_noise"
  }
 },
 "D1_guider": {
  "class_type": "BasicGuider",
  "inputs": {
   "model": [
    "regional_model",
    0
   ],
   "conditioning": [
    "r2v",
    0
   ]
  },
  "_meta": {
   "title": "Движок · D1_guider"
  }
 },
 "D1_sampler": {
  "class_type": "KSamplerSelect",
  "inputs": {
   "sampler_name": "euler"
  },
  "_meta": {
   "title": "Движок · D1_sampler"
  }
 },
 "D1_sample": {
  "class_type": "SamplerCustomAdvanced",
  "inputs": {
   "noise": [
    "D1_noise",
    0
   ],
   "guider": [
    "D1_guider",
    0
   ],
   "sampler": [
    "D1_sampler",
    0
   ],
   "sigmas": [
    "D1_lat",
    1
   ],
   "latent_image": [
    "D1_lat",
    0
   ]
  },
  "_meta": {
   "title": "Движок · D1_sample"
  }
 },
 "D1_decode": {
  "class_type": "H3ImageDecode",
  "inputs": {
   "samples": [
    "D1_sample",
    0
   ],
   "vae": [
    "vae",
    0
   ]
  },
  "_meta": {
   "title": "Движок · D1_decode"
  }
 },
 "D1_select": {
  "class_type": "H3ImageFrameSelector",
  "inputs": {
   "frames": [
    "D1_decode",
    0
   ],
   "recommended_index": [
    "D1_decode",
    3
   ],
   "strategy": "decode_recommended",
   "manual_index": 2,
   "skip_first_frames": 0,
   "candidate_start": 0.0,
   "candidate_end": 1.0,
   "similarity_weight": 0.25,
   "top_k": 4,
   "emit_candidate_batch": false
  },
  "_meta": {
   "title": "Движок · D1_select"
  }
 },
 "prompt_text": {
  "class_type": "StringFunction|pysssss",
  "inputs": {
   "action": "append",
   "tidy_tags": "no",
   "text_a": "",
   "text_b": "",
   "text_c": ""
  },
  "_meta": {
   "title": "String · промпт H3 + правки"
  }
 },
 "playblast5": {
  "class_type": "RepeatImageBatch",
  "inputs": {
   "image": [
    "playblast_input",
    0
   ],
   "amount": 5
  },
  "_meta": {
   "title": "Плейбласт ×5"
  }
 },
 "final_composite": {
  "class_type": "ImageCompositeMasked",
  "inputs": {
   "destination": [
    "plate_scale",
    0
   ],
   "source": [
    "D1_select",
    0
   ],
   "mask": [
    "strength_mask",
    0
   ],
   "x": 0,
   "y": 0,
   "resize_source": false
  },
  "_meta": {
   "title": "Вклейка · фон из плиты"
  }
 },
 "playblast_input": {
  "class_type": "LoadImage",
  "inputs": {
   "image": "3da_manual/playblast.png"
  },
  "_meta": {
   "title": "Вход · playblast"
  }
 },
 "init_input": {
  "class_type": "LoadImage",
  "inputs": {
   "image": "3da_manual/init.png"
  },
  "_meta": {
   "title": "Вход · init"
  }
 },
 "strength_input": {
  "class_type": "LoadImage",
  "inputs": {
   "image": "3da_manual/strength.png"
  },
